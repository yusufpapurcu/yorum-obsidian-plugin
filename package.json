{
  "name": "yorum",
  "version": "0.1.2",
  "private": true,
  "description": "Talk with your Markdown notes: an AI commentary layer stored in sidecar files, never in your notes.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "npm run typecheck && node esbuild.config.mjs --production",
    "build:dev": "npm run typecheck && node esbuild.config.mjs",
    "install-plugin": "npm run typecheck && node esbuild.config.mjs --install",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "marked": "^15.0.0"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "obsidian": "^1.14.4",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.0.0"
  }
}
