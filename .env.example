# Any OpenAI-compatible chat completions endpoint (base URL or full …/chat/completions URL).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Optional
# VAULT_DIR=./sample-vault
# PORT=4317
# Web search: Gemini models use Google Search grounding via <origin>/v1beta by default.
# WEB_SEARCH=off
# GEMINI_BASE_URL=https://api.orcarouter.ai/v1beta
